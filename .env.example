# Discover Slovenia AI — okolje (primer za razvoj)
# SQLite za lokalni razvoj; v produkciji izvirnik uporablja Neon Postgres
# (celotna izvirna shema: docs/recovery/schema-1.163.4.prisma)
DATABASE_URL="file:./db/custom.db"

# NextAuth v4 (JWT, credentials — 48-a)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Lastna tržnica — Stripe B2C checkout (48-c)
# PRAVA plačila: obe ključa iz Stripe dashboarda (v .env, NIKOLI v kodi).
# Brez STRIPE_SECRET_KEY je checkout FAIL-CLOSED (503), razen če je
# DSA_DEMO_PAYMENTS=1 (demo naročila takoj "paid" z demo: true — brez
# prave bremenitve, v UI izrecno označeno).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DSA_DEMO_PAYMENTS=1

# Rezervacijski partnerji (P0-F 2.10.0) — NEOBVEZNO, vsak posebej.
# ID partnerja v njegovem programu aktivira provizijsko povezavo tistega
# partnerja. P0-F partnerji brez javno dokumentiranega vzorca žetona
# (viator/tiqets/skyscanner/airalo/discovercars/worldnomads/safetywing)
# potrebujejo tudi AFFILIATE_*_TMPL s pravim vzorcem iz programa — brez
# žetona povezave delujejo javno, klikanja se štejejo (iskrena veriga).
# AFFILIATE_BOOKING_ID=
# AFFILIATE_GYG_ID=
# AFFILIATE_KIWI_ID=
# AFFILIATE_RENTALCARS_ID=
# AFFILIATE_OMIO_ID=
# AFFILIATE_VIATOR_ID=
# AFFILIATE_VIATOR_TMPL=
# AFFILIATE_TIQETS_ID=
# AFFILIATE_TIQETS_TMPL=
# AFFILIATE_SKYSCANNER_ID=
# AFFILIATE_SKYSCANNER_TMPL=
# AFFILIATE_AIRALO_ID=
# AFFILIATE_AIRALO_TMPL=
# AFFILIATE_DISCOVERCARS_ID=
# AFFILIATE_DISCOVERCARS_TMPL=
# AFFILIATE_WORLDNOMADS_ID=
# AFFILIATE_WORLDNOMADS_TMPL=
# AFFILIATE_SAFETYWING_ID=
# AFFILIATE_SAFETYWING_TMPL=

# Skrbniški dostop /owner/* (vejica ločen seznam e-poštnih naslovov)
DSA_ADMIN_EMAILS=
