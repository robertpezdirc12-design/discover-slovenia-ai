# ---------------------------------------------------------------------------
# Baza (obvezno)
# ---------------------------------------------------------------------------
# Lokalni razvoj: `docker compose up -d`
# Produkcija: Postgres (Neon, Supabase, Railway ...) z naslovom, ki podpira
# connection pooling. Nikoli ne committaj pravega .env.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/discover_slovenia?schema=public&connect_timeout=5"

# ---------------------------------------------------------------------------
# Javni URL aplikacije (SEO, canonical, Open Graph, deljene poti)
# ---------------------------------------------------------------------------
# Lokalno: http://localhost:3000
# Produkcija: https://tvoja-domena.si
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Prijava z enkratno povezavo na e-pošto (magic link)
# ---------------------------------------------------------------------------
# Brez RESEND_API_KEY ali AUTH_EMAIL_FROM se v razvoju povezava izpiše v
# terminal in v prijavni dialog (devLink). V produkciji brez konfiguracije
# prijava zavrne z 503.
# Pošiljatelj mora biti potrjen v Resendu.
RESEND_API_KEY=""
AUTH_EMAIL_FROM="Discover Slovenia <prijava@example.com>"

# Neobvezno: javni URL za prijavne povezave, če se razlikuje od
# NEXT_PUBLIC_SITE_URL (npr. lokalni test na drugem portu ali preview).
# AUTH_URL="http://localhost:3101"

# ---------------------------------------------------------------------------
# Dnevno čiščenje (Vercel Cron)
# ---------------------------------------------------------------------------
# Naključna skrivnost; Vercel jo pošlje kot `Authorization: Bearer <secret>`.
# Brez nje je /api/cron/cleanup onemogočen (503).
CRON_SECRET="zamenjaj-z-nakljucno-vrednostjo"
