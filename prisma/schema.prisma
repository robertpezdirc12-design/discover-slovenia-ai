// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Ponudnik prenočitve v Sloveniji — iz uradnega registra (AJPES Poslovni
/// register Slovenije, registrirani sobodajalci) ali iz OpenStreetMap.
/// `id`: "ajpes-<maticna>" (uradni vir) ali OSM ključ ("n123", "w456").
model Apartment {
  id        String   @id
  name      String
  lat       Float
  lng       Float
  city      String?
  street    String?
  postcode  String?
  obcina    String?
  legalForm String?
  maticna   String?
  website   String?
  phone     String?
  stars     Int?
  source    String   @default("photon")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Predpomnilnik geokodiranja uradnih naslovov (ključ = normaliziran naslov).
/// `match`: exact (ulica + hišna št.) | settlement (center naselja) | miss.
model GeocodeCache {
  key       String   @id
  lat       Float?
  lng       Float?
  obcina    String?
  match     String   @default("miss")
  checkedAt DateTime @default(now())
}

/// En sam vrstica metapodatkov usklajevanja (id = "apartments-sync").
model SyncState {
  id        String   @id
  updatedAt DateTime @default(now())
  source    String   @default("photon")
  count     Int      @default(0)
}