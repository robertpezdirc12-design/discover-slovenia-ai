// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Rezervacija prenočišča ("Rezerviraj" na zemljevidu).
/// Vsak OSM objekt je enkraten (stayId unique, idempotentno); zapis je
/// evidenca poštenega rezerviranja — pravo plačilo pri objektu/uradni strani.
model StayReservation {
  id        String   @id @default(cuid())
  stayId    String   @unique
  name      String
  city      String
  lat       Float
  lng       Float
  priceFrom Int?
  createdAt DateTime @default(now())
}

/// Deljena pot (/pot/[id]) — posnetek vodenega toka, ki ga uporabnik
/// deli s povezavo (Wanderlotov vzorec: "poglej moj načrt").
/// `data` = JSON sanitiziranega GuideState (brez glasu/časovnih žigov —
/// prejemnik dobi svojo svežo sejo, ne tuje nastavitve).
model SharedTrip {
  id        String   @id
  data      String
  createdAt DateTime @default(now())
}