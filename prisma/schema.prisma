// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Uporabnik profila. Prijava poteka z enkratno povezavo na e-pošto
/// (magic link); gesla ne shranjujemo. Stari demo uporabniki imajo email null.
model User {
  id        String   @id @default(cuid())
  email     String?  @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions     Session[]
  profile      UserProfile?
  reservations StayReservation[]
}

/// Enkratna prijavna povezava. V bazi je samo SHA-256 hash žetona; surov
/// žeton potuje le po e-pošti. `usedAt` prepreči ponovno uporabo.
model LoginToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, createdAt])
  @@index([expiresAt])
  @@index([usedAt])
}

/// Strežniška seja: v bazi je samo SHA-256 hash žetona, ne surov žeton.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Sanitiziran GuideState (interesi, regija, dnevi, tempo, rezervacije),
/// ki ga odjemalec sinhronizira iz localStorage. Podlaga za priporočila.
model UserProfile {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  guideData Json?
  updatedAt DateTime @updatedAt
}

/// Rezervacija prenočišča ("Rezerviraj" na zemljevidu).
/// Per-user idempotentno: isti uporabnik ne more dvakrat shraniti istega
/// objekta, dva uporabnika pa lahko. Pravo plačilo pri objektu/uradni strani.
model StayReservation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stayId    String
  name      String
  city      String
  lat       Float
  lng       Float
  priceFrom Int?
  createdAt DateTime @default(now())

  @@unique([userId, stayId])
  @@index([userId])
}

/// Deljena pot (/pot/[id]) — posnetek vodenega toka, ki ga uporabnik
/// deli s povezavo (Wanderlotov vzorec: "poglej moj načrt").
/// `data` = JSON sanitiziranega GuideState (brez glasu/časovnih žigov —
/// prejemnik dobi svojo svežo sejo, ne tuje nastavitve).
model SharedTrip {
  id        String   @id
  data      String
  createdAt DateTime @default(now())

  @@index([createdAt])
}
