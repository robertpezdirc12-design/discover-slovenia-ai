<script>
       function filterCountries(searchInput) {
        const searchTerm = searchInput.value.toLowerCase();
        const allItems = document.querySelectorAll('.Nav-languages-item');
        const separator = document.querySelector('.Nav-languages-separator');
        let hasVisibleItems = false;

        allItems.forEach(item => {
            const countryName = item.textContent.trim().toLowerCase();
            if (countryName.includes(searchTerm)) {
                item.style.display = '';
                hasVisibleItems = true;
            } else {
                item.style.display = 'none';
            }
        });

        // Hide separator if no results
        if (separator) {
            separator.style.display = hasVisibleItems ? '' : 'none';
        }
    }
</script>

