rentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-menu size-5" aria-hidden="true"><path d="M4 12h16"></path><path d="M4 18h16"></path><path d="M4 6h16"></path></svg><span>Več</span></button></div></nav><main class="mx-auto w-full max-w-3xl flex-1 px-4 py-16 sm:px-6 lg:px-8"><h1 class="text-4xl font-bold mb-6">Vir podatkov</h1><p class="text-muted-foreground mb-8">Platforma Discover Slovenia AI uporablja naslednje vire podatkov za zagotavljanje kakovostnih informacij o slovenskih turističnih destinacijah.</p><div class="space-y-4"><div class="rounded-lg border border-border p-4"><div class="flex items-start justify-between gap-4"><div><h3 class="font-semibold">OpenStreetMap</h3><p class="text-sm text-muted-foreground mt-1">POI podatki (točke interesa) — atrakcije, muzeji, restavracije, hoteli, razgledišča, naravne znamenitosti, religiozni objekti. Licenca: ODbL.</p></div><span class="text-xs bg-muted px-2 py-1 rounded shrink-0">POI baza</span></div><a href="https://www.openstreetmap.org" target="_blank" rel="noopener noreferrer" class="text-sm text-primary underline mt-2 inline-block">https://www.openstreetmap.org<!-- --> →</a></div><div class="rounded-lg border border-border p-4"><div class="flex items-start justify-between gap-4"><div><h3 class="font-semibold">I feel Slovenia (STO) — slovenia.info</h3><p class="text-sm text-muted-foreground mt-1">Uradna turistična vsebina I feel Slovenia (Slovenska turistična organizacija) — 664 strukturiranih virov iz slovenia.info llms.txt indeksa, ki jih AI uporablja kot uzemljenje odgovorov s citati. Posodobljeno: september 2026.</p></div><span class="text-xs bg-muted px-2 py-1 rounded shrink-0">Uradni viri (RAG)</span></div><a href="https://www.slovenia.info" target="_blank" rel="noopener noreferrer" class="text-sm text-primary underline mt-2 inline-block">https://www.slovenia.info<!-- --> →</a></div><div class="rounded-lg border border-border p-4"><div class="flex items-start justify-between gap-4"><div><h3 class="font-semibold">Wikipedia / Wikidata</h3><p class="text-sm text-muted-foreground mt-1">Opisi destinacij in POI-jev. Licenca: CC BY-SA.</p></div><span class="text-xs bg-muted px-2 py-1 rounded shrink-0">Opisi</span></div><a href="https://www.wikimedia.org" target="_blank" rel="noopener noreferrer" class="text-sm text-primary underline mt-2 inline-block">https://www.wikimedia.org<!-- --> →</a></div><div class="rounded-lg border border-border p-4"><div class="flex items-start justify-between gap-4"><div><h3 class="font-semibold">Open-Meteo</h3><p class="text-sm text-muted-foreground mt-1">Vremenski podatki v realnem času. Brezplačni API brez ključa.</p></div><span class="text-xs bg-muted px-2 py-1 rounded shrink-0">Vreme</span></div><a href="https://open-meteo.com" target="_blank" rel="noopener noreferrer" class="text-sm text-primary underline mt-2 inline-block">https://open-meteo.com<!-- --> →</a></div><div class="rounded-lg border border-border p-4"><div class="flex items-start justify-between gap-4"><div><h3 class="font-semibold">z-ai-web-dev-sdk (vizija — opcijsko)</h3><p class="text-sm text-muted-foreground mt-1">AI generiranje itinererjev na podlagi uporabnikovih preferenc.</p></div><span class="text-xs bg-muted px-2 py-1 rounded shrink-0">AI</span></div><a href="https://z.ai" target="_blank" rel="noopener noreferrer" class="text-sm text-primary underline mt-2 inline-block">https://z.ai<!-- --> →</a></div></div><section aria-labelledby="data-freshness" class="mt-12"><h2 id="data-freshness" class="text-2xl font-bold mb-3">Svežina podatkov</h2><p class="text-sm text-muted-foreground mb-4">Za vsak glavni podatkovni sloj objavljamo svežino in vrsto vira. Živo pomeni, da je bil podatek preverjen ob prikazu; sveže in zastarelo sta določeni glede na starost zajema; neznano pomeni, da časa zajema ni mogoče določiti. Vrsta vira je kanonski termin: LIVE (živ vir), STATIC (statičen posnetek oziroma kurirani vodnik), USER (uporabnikov vnos), PROVIDER (partnerjev vir), GENERATED (umetno inteligenco generirano).</p><div class="mb-6 rounded-lg border border-amber-300/70 bg-amber-50/70 p-4 dark:border-amber-900/50 dark:bg-amber-950/30"><p class="text-xs leading-relaxed text-amber-900 dark:text-amber-200">Posnetek množice krajev ni živo stanje: število točk iz statičnega posnetka (npr. Foursquare Open Places, 2025-02-06) NE pomeni, da je enako število krajev trenutno odprtih ali živih — posnetek je stanje ob dnevu zajema.</p></div><div class="overflow-x-auto rounded-lg border border-border"><table class="w-full text-xs border-collapse min-w-[720px]"><thead><tr class="bg-muted/50"><th scope="col" class="text-left font-semibold p-2 border-b border-border whitespace-nowrap">Sloj</th><th scope="col" class="text-left font-semibold p-2 border-b border-border whitespace-nowrap">Vrsta vira</th><th scope="col" class="text-left font-semibold p-2 border-b border-border whitespace-nowrap">Svežina</th><th scope="col" class="text-left font-semibold p-2 border-b border-border">Podrobnosti</th></tr></thead><tbody><tr class="align-top"><th scope="row" class="text-left font-medium p-2 border-b border-border/60 whitespace-nowrap">OpenStreetMap</th><td class="p-2 border-b border-border/60 whitespace-nowrap"><span class="font-mono text-[11px] text-muted-foreground">LIVE</span></td><td class="p-2 border-b border-border/60 whitespace-nowrap"><span class="inline-block px-1.5 py-0.5 rounded font-medium bg-green-100 text-green-800 dark:bg-green-950 dark:text-green-300">živo</span></td><td class="p-2 border-b border-border/60">žive Overpass poizvedbe ob vsakem iskanju POI (ODbL)</td></tr><tr class="align-top"><th scope="row" class="text-left font-medium p-2 border-b border-border/60 whitespace-nowrap">Foursquare Open Places</th><td class="p-2 border-b border-border/60 whitespace-nowrap"><span class="font-mono text-[11px] text-muted-foreground">STATIC</span></td><td class="p-2 border-b border-border/60 whitespace-nowrap"><span class="inline-block px-1.5 py-0.5 rounded font-medium bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300">zastarelo</span><span class="block mt-0.5 text-[10px] text-muted-foreground/80">2025-02-06</span></td><td class="p-2 border-b border-border/60">statični posnetek množice krajev — NI živo stanje (osvežitev: bun run fsq:ingest)</td></tr><tr class="align-top"><th scope="row" class="text-left font-medium p-2 border-b border-border/60 whitespace-nowrap">Open-Meteo</th><td class="p-2 border-b border-border/60 whitespace-nowrap"><span class="font-mono text-[11px] text-muted-foreground">LIVE</span></td><td class="p-2 border-b border-border/60 whitespace-nowrap"><span class="inline-block px-1.5 py-0.5 rounded font-medium bg-green-100 text-green-800 dark:bg-green-950 dark:text-green-300">živo</span></td><td class="p-2 border-b border-border/60">živi API; pomnilniški predpomnilnik 10–15 minut</td></tr><tr class="align-top"><th scope="row" class="text-left font-medium p-2 border-b border-border/60 whitespace-nowrap">Destinacije (uredniški vodnik)</th><td class="p-2 border-b border-border/60 whitespace-nowrap"><span class="font-mono text-[11px] text-muted-foreground">STATIC</span></td><td class="p-2 border-b border-border/60 whitespace-nowrap"><span class="inline-block px-1.5 py-0.5 rounded font-medium bg-teal-100 text-teal-800 dark:bg-teal-950 dark:text-teal-300">sveže</span><span class="block mt-0.5 text-[10px] text-muted-foreground/80">pred 16 dnevi</span></td><td class="p-2 border-b border-border/60">uredniško kurirani vodnik; stanje podatkov na 2026-09-20</td></tr><tr class="align-top"><th scope="row" class="text-left font-medium p-2 border-b border-border/60 whitespace-nowrap">Prevozi (od-cene)</th><td class="p-2 border-b border-border/60 whitespace-nowrap"><span class="font-mono text-[11px] text-muted-foreground">STATIC</span></td><td class="p-2 border-b border-border/60 whitespace-nowrap"><span class="inline-block px-1.5 py-0.5 rounded font-medium bg-muted/60 text-muted-foreground/80">neznano</span></td><td class="p-2 border-b border-border/60">od-cene iz statičnega inventarja — žive cene prek API niso na voljo (preveri pri ponudniku)</td></tr><tr class="align-top"><th scope="row" class="text-left font-medium p-2 border-b border-border/60 whitespace-nowrap">Affiliate ponudbe</th><td class="p-2 border-b border-border/60 whitespace-nowrap"><span class="font-mono text-[11px] text-muted-foreground">PROVIDER</span></td><td class="p-2 border-b border-border/60 whitespace-nowrap"><span class="inline-block px-1.5 py-0.5 rounded font-medium bg-muted/60 text-muted-foreground/80">neznano</span></td><td class="p-2 border-b border-border/60">samo partnerska povezava — brez preverjenih podatkov o ponudbi</td></tr></tbody></table></div></section><section aria-labelledby="destination-content-provenance" class="mt-12"><h2 id="destination-content-provenance" class="text-2xl font-bold mb-3">Provenance destinacijske vsebine (38 destinacij)</h2><p class="text-sm text-muted-foreground mb-4">Vsaka destinacija v uredniškem vodniku nosi zapis o viru in datumu: ali ima zunanjega preverjenega vira (uradna stran destinacije ali kanonična STO stran), ali je uredniško kurirana vsebina Discover Slovenia (pošteno označeno, brez izmišljenega vira). Enak zapis je dostopen prek API-ja (polje provenance + glava X-Data-As-Of) in na strani vsake destinacije.</p><p class="mb-6 inline-flex flex-wrap items-center gap-1.5 rounded-lg border border-border bg-muted/30 px-3 py-2 text-xs font-medium"><span class="inline-block size-2 rounded-full bg-primary" aria-hidden="true"></span>38 destinacij · 9 z uradnim virom · 29 uredniško kuriranih · posodobljeno 2026-09-20</p><div class="overflow-x-auto rounded-lg border border-border"><table class="w-full text-xs border-collapse min-w-[560px]"><thead><tr class="bg-muted/50"><th scope="col" class="text-left font-semibold p-2 border-b border-border whitespace-nowrap">Destinacija</th><th scope="col" class="text-left font-semibold p-2 border-b border-border">Uradni vir</th><th scope="col" class="text-left font-semibold p-2 border-b border-border whitespace-nowrap">Preverjeno</th></tr></thead><tbody><tr class="align-top"><th scope="row" class="text-left font-medium p-2 border-b border-border/60 whitespace-nowrap">Postojnska jama</th><td class="p-2 border-b border-border/60"><a href="https://www.postojnska-jama.eu" target="_blank" rel="noopener noreferrer" class="text-primary underline underline-offset-2">postojnska-jama.eu<!-- --> →</a></td><td class="p-2 border-b border-border/60 whitespace-nowrap"><time dateTime="2026-09-14">2026. 09. 14</time></td></tr><tr class="align-top"><th scope="row" class="text-left font-medium p-2 border-b border-border/60 whitespace-nowrap">Kobarid</th><td class="p-2 border-b border-border/60"><a href="https://www.kobariski-muzej.si" target="_blank" rel="noopener noreferrer" class="text-primary underline underline-offset-2">kobariski-muzej.si<!-- --> →</a></td><td class="p-2 border-b border-border/60 whitespace-nowrap"><time dateTime="2026-09-14">2026. 09. 14</time></td></tr><tr class="align-top"><th scope="row" class="text-left font-medium p-2 border-b border-border/60 whitespace-nowrap">Vintgarska soteska</th><td class="p-2 border-b border-border/60"><a href="https://www.vintgar.si" target="_blank" rel="noopener noreferrer" class="text-primary underline underline-offset-2">vintgar.si<!-- --> →</a></td><td class="p-2 border-b border-border/60 whitespace-nowrap"><time dateTime="2026-09-14">2026. 09. 14</time></td></tr><tr class="align-top"><th scope="row" class="text-left font-medium p-2 border-b border-border/60 whitespace-nowrap">Ptuj</th><td class="p-2 border-b border-border/60"><a href="https://www.pmpo.si" target="_blank" rel="noopener noreferrer" class="text-primary underline underline-offset-2">pmpo.si<!-- --> →</a></td><td class="p-2 border-b border-border/60 whitespace-nowrap"><time dateTime="2026-09-14">2026. 09. 14</time></td></tr><tr class="align-top"><th scope="row" class="text-left font-medium p-2 border-b border-border/60 whitespace-nowrap">Celje</th><td class="p-2 border-b border-border/60"><a href="https://www.visitcelje.eu" target="_blank" rel="noopener noreferrer" class="text-primary underline underline-offset-2">visitcelje.eu<!-- --> →</a></td><td class="p-2 border-b border-border/60 whitespace-nowrap"><time dateTime="2026-09-14">2026. 09. 14</time></td></tr><tr class="align-top"><th scope="row" class="text-left font-medium p-2 border-b border-border/60 whitespace-nowrap">Bled</th><td class="p-2 border-b border-border/60"><a href="https://www.slovenia.info/en/places-to-go/regions/alpine-slovenia/bled" target="_blank" rel="noopener noreferrer" class="text-primary underline underline-offset-2">slovenia.info (STO)<!-- --> →</a></td><td class="p-2 border-b border-border/60 whitespace-nowrap"><time dateTime="2026-09-25">2026. 09. 25</time></td></tr><tr class="align-top"><th scope="row" class="text-left font-medium p-2 border-b border-border/60 whitespace-nowrap">Ljubljana</th><td class="p-2 border-b border-border/60"><a href="https://www.slovenia.info/en/places-to-go/regions/ljubljana-central-slovenia/ljubljana" target="_blank" rel="noopener noreferrer" class="text-primary underline underline-offset-2">slovenia.info (STO)<!-- --> →</a></td><td class="p-2 border-b border-border/60 whitespace-nowrap"><time dateTime="2026-09-25">2026. 09. 25</time></td></tr><tr class="align-top"><th scope="row" class="text-left font-medium p-2 border-b border-border/60 whitespace-nowrap">Piran</th><td class="p-2 border-b border-border/60"><a href="https://www.slovenia.info/en/places-to-go/attractions/piran-and-salt-pans" target="_blank" rel="noopener noreferrer" class="text-primary underline underline-offset-2">slovenia.info (STO)<!-- --> →</a></td><td class="p-2 border-b border-border/60 whitespace-nowrap"><time dateTime="2026-09-25">2026. 09. 25</time></td></tr><tr class="align-top"><th scope="row" class="text-left font-me